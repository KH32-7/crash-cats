{
  "name": "crash-cats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "sim:balance": "tsx tools/sim-harness.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "lil-gui": "^0.21.0",
    "peerjs": "^1.5.5",
    "three": "^0.184.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
